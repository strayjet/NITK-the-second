# Reference only — not loaded by any service.
# Real config lives in ml-service/.env and backend/.env (copy from each
# service's own .env.example).

# ml-service (citymind-yolo-service) listens on:
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://localhost:8001

# backend (citymind-backend / Event Aggregator) listens on:
BACKEND_PORT=9000
BACKEND_URL=http://localhost:9000

# backend must point at ml-service using this exact value
# (set in backend/.env as YOLO_SERVICE_BASE_URL):
YOLO_SERVICE_BASE_URL=http://localhost:8001

# PostgreSQL (docker-compose service name: postgres):
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://citymind:citymind@localhost:5432/citymind

# Redis (docker-compose service name: redis) — powers real-time WebSocket
# fan-out across backend replicas. Optional; backend works without it.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# frontend (static dashboard, served by nginx in Docker):
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:8080

# backend WebSocket (real-time incident/dashboard push):
BACKEND_WS_URL=ws://localhost:9000/ws/live
