{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DetectionEvent",
  "description": "One frame-level observation produced by ml-service (citymind-yolo-service) and consumed by backend (citymind-backend / Event Aggregator). Source of truth: ml-service/app/schemas.py. Mirrored (not imported) in backend/app/models/detection.py.",
  "type": "object",
  "required": ["camera_id", "timestamp"],
  "properties": {
    "camera_id": { "type": "string" },
    "road_id": { "type": ["string", "null"] },
    "lat": { "type": ["number", "null"] },
    "lng": { "type": ["number", "null"] },
    "timestamp": { "type": "string", "format": "date-time", "description": "ISO-8601, e.g. 2026-08-01T10:03:12+00:00" },
    "frame_index": { "type": ["integer", "null"] },
    "accident": { "type": "boolean", "default": false },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.0 },
    "vehicles": {
      "type": "object",
      "properties": {
        "total": { "type": "integer", "default": 0 },
        "cars": { "type": "integer", "default": 0 },
        "buses": { "type": "integer", "default": 0 },
        "trucks": { "type": "integer", "default": 0 },
        "motorcycles": { "type": "integer", "default": 0 },
        "bicycles": { "type": "integer", "default": 0 }
      }
    },
    "traffic_density": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"], "default": "LOW" },
    "emergency_vehicle": { "type": "boolean", "default": false },
    "bounding_boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "confidence", "x1", "y1", "x2", "y2"],
        "properties": {
          "label": { "type": "string" },
          "confidence": { "type": "number" },
          "track_id": { "type": ["integer", "null"] },
          "x1": { "type": "number" },
          "y1": { "type": "number" },
          "x2": { "type": "number" },
          "y2": { "type": "number" }
        }
      }
    }
  },
  "definitions": {
    "VideoDetectionResponse": {
      "description": "Returned by /detect/video, /detect/stream, /detect/webcam — many DetectionEvents, one per processed frame.",
      "type": "object",
      "properties": {
        "camera_id": { "type": "string" },
        "road_id": { "type": ["string", "null"] },
        "frames_processed": { "type": "integer" },
        "events": { "type": "array", "items": { "$ref": "#" } }
      }
    },
    "HealthResponse": {
      "description": "Returned by GET /health on ml-service.",
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["ok"] },
        "service": { "type": "string" },
        "yolo_model_loaded": { "type": "boolean" },
        "accident_model_loaded": { "type": "boolean" }
      }
    }
  }
}
